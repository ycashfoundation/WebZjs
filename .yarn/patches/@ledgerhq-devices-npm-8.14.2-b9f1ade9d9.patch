+// Parcel 2.13's resolver mishandles subpath patterns in this package's
+// exports map (the `"./*": { "default": "./lib-es/*.js" }` shape — Parcel
+// drops the `.js` substitution and tries to load `./hid-framing` literally
+// from the package root). `@ledgerhq/hw-transport-webhid` imports
+// `@ledgerhq/devices/hid-framing` internally, so the wallet build dies
+// at bundle time on `Cannot load file './hid-framing'`.
+//
+// Workaround: a real file at the literal subpath sidesteps the exports
+// map and gives Parcel something to resolve. Re-exports from lib-es so
+// no behavior change.
+export * from "./lib-es/hid-framing.js";
+export { default } from "./lib-es/hid-framing.js";
